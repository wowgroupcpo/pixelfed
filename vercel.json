{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/patch-vercel-php.cjs",
  "installCommand": "echo 'PHP project: skipping npm install'",
  "outputDirectory": null,
  "env": {
    "VERCEL_PHP_DOCROOT": "public"
  },
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,tests/**,phpstan/**,.github/**,.ddev/**,notes/**,storage/logs/**,storage/framework/cache/**,database/*.sqlite}"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/index\\.php$", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
