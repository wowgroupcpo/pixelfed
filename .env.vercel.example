# Pixelfed on Vercel + Supabase — environment template (best-effort demo)
# Copy these keys into Vercel Project Settings > Environment Variables.
# NEVER commit real secrets. See DEPLOYMENT_VERCEL.md for the full guide.

APP_NAME="Pixelfed"
APP_ENV="production"
APP_KEY="base64:GENERATE_WITH_php_artisan_key:generate"
APP_DEBUG="false"
APP_LOCALE="en-US"
APP_URL="https://pixelfed-cpo16.vercel.app"
APP_DOMAIN="pixelfed-cpo16.vercel.app"
ADMIN_DOMAIN="pixelfed-cpo16.vercel.app"
SESSION_DOMAIN=null
TRUST_PROXIES="*"

OPEN_REGISTRATION="true"
ENFORCE_EMAIL_VERIFICATION="false"
PF_MAX_USERS="1000"
OAUTH_ENABLED="false"
ENABLE_CONFIG_CACHE="false"
INSTANCE_DISCOVER_PUBLIC="true"

# No vips/FFI, GD or Imagick in the vercel-php runtime: image processing
# is unavailable on Vercel (uploads will fail). Kept only so config loads.
IMAGE_DRIVER="gd"
PF_OPTIMIZE_IMAGES="false"
PF_C2PA_ENABLED="false"

# Composer kills scripts after 300s by default — build-time migrations
# of 271 migrations cross-region need much longer.
COMPOSER_PROCESS_TIMEOUT="3600"

# Supabase Postgres — transaction pooler (IPv4) for serverless runtime
DB_CONNECTION="pgsql"
DB_HOST="aws-1-ap-southeast-1.pooler.supabase.com"
DB_PORT="6543"
DB_DATABASE="postgres"
DB_USERNAME="postgres.YOUR_PROJECT_REF"
DB_PASSWORD="YOUR_SUPABASE_DB_PASSWORD"
DB_SSLMODE="require"
# Session pooler used only by build-time migrations (scripts/vercel-build.php)
VERCEL_MIGRATE_DB_HOST="aws-1-ap-southeast-1.pooler.supabase.com"
VERCEL_MIGRATE_DB_PORT="5432"
VERCEL_MIGRATE_DB_USERNAME="postgres.YOUR_PROJECT_REF"

# No Redis / Horizon / scheduler on Vercel: database + sync fallbacks
SESSION_DRIVER="database"
CACHE_STORE="database"
QUEUE_CONNECTION="sync"
QUEUE_DRIVER="sync"
BROADCAST_DRIVER="log"
LOG_CHANNEL="errorlog"

# Media stays local (/tmp, ephemeral). For real media use Supabase Storage
# S3 credentials here and set PF_ENABLE_CLOUD="true".
PF_ENABLE_CLOUD="false"
FILESYSTEM_CLOUD="s3"

ACTIVITY_PUB="false"
AP_REMOTE_FOLLOW="false"
AP_INBOX="false"
AP_OUTBOX="false"
AP_SHAREDINBOX="false"

MAIL_DRIVER="log"
MAIL_FROM_ADDRESS="pixelfed@example.com"
MAIL_FROM_NAME="Pixelfed"
